# PostgreSQL connection string from your database provider (for example Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Generate a unique secret (at least 32 random characters). Keep it private.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional comma-separated exact origins trusted by Better Auth (no trailing slash)
# ADDITIONAL_TRUSTED_ORIGINS="https://www.example.com,https://admin.example.com"
