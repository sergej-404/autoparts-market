# PostgreSQL connection string from Neon. In production, use the pooled hostname
# containing "-pooler" and append connection_limit=1 to the URL query string.
# Keep the direct (non-pooler) URL only for migrations/admin tooling when required.
DATABASE_URL=""

# Better Auth: generate a random secret of at least 32 bytes.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Optional comma-separated trusted origins, without trailing slashes.
ADDITIONAL_TRUSTED_ORIGINS=""

# Vercel Blob: required for administrator listing image uploads.
BLOB_READ_WRITE_TOKEN=""

# Web Push: optional; generate a matching VAPID key pair.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Temporarily enable structured server-side performance timings in Vercel logs.
# Set to false or remove after collecting cold/warm request samples.
AXION_PERFORMANCE_DIAGNOSTICS="false"
